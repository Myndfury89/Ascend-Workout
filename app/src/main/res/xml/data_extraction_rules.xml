<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Health/fitness data is sensitive. Exclude the database and datastore from
         cloud backup and device-transfer by default; sync is explicit opt-in. -->
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
